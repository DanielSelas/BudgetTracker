rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // קיבוץ שורות בתוך קטגוריה. אופציונלי, וכשהוא קיים הוא טקסט קצר:
    // הוא משמש כמפתח לקיבוץ בתצוגה, ולכן מחרוזת ארוכה הייתה שוברת אותה.
    function validGroupKey(data) {
      return !('groupKey' in data)
        || (data.groupKey is string
            && data.groupKey.size() > 0
            && data.groupKey.size() <= 40);
    }

    // מועד חיוב אופציונלי: לתקציבים שנוצרו לפניו אין אותו כלל,
    // ולכן היעדרו תקין. כשהוא קיים הוא יום בחודש שקיים בכל חודש.
    function validBillingDay(data) {
      return !('billingDay' in data)
        || (data.billingDay is int && data.billingDay >= 1 && data.billingDay <= 28);
    }

    // סכום הבסיס שהמשתמש מתכנן. אופציונלי, ואפס פירושו גזירה
    // אוטומטית מההכנסה, כפי שהיה לפני שהשדה היה קיים.
    // עותק לקריאה אנושית. אינו משמש להרשאות, ולכן די בכך שהוא
    // המייל של מי שכותב: כך אי אפשר לשתול שם מייל של מישהו אחר.
    function validOwnerEmail(data) {
      return !('ownerEmail' in data)
        || data.ownerEmail == ''
        || data.ownerEmail == request.auth.token.email;
    }

    // רשימת החברים לתצוגה. עותק של תת האוסף members, שהוא מקור
    // האמת, ולכן די בהגבלת גודל כדי שלא תהפוך לשדה חופשי.
    function validMemberEmails(data) {
      return !('memberEmails' in data)
        || (data.memberEmails is list && data.memberEmails.size() <= 20);
    }

    function validBaseAmount(data) {
      return !('baseAmount' in data)
        || (data.baseAmount is number && data.baseAmount >= 0);
    }

    function memberExists(budgetId, uid) {
      return exists(/databases/$(database)/documents/budgets/$(budgetId)/members/$(uid));
    }

    function isMember(budgetId) {
      return signedIn() && memberExists(budgetId, request.auth.uid);
    }

    function isOwner(budgetId) {
      return signedIn()
        && get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerUid == request.auth.uid;
    }

    // הזמנה תקפה: קיימת, שייכת לתקציב הנכון, לא נוצלה ולא פגה
    function validInvite(code, budgetId) {
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return invite.budgetId == budgetId
        && invite.active == true
        && request.time < invite.expiresAt;
    }

    match /budgets/{budgetId} {
      allow read: if isMember(budgetId);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.type in ['household', 'trip', 'goal']
        && validBillingDay(request.resource.data)
        && validBaseAmount(request.resource.data)
        && validOwnerEmail(request.resource.data)
        && validMemberEmails(request.resource.data)
        // לטיול ולמטרה יש סכום שנקבע מראש; למשק בית אין
        && (request.resource.data.type == 'household'
            || (request.resource.data.frame is number
                && request.resource.data.frame >= 0));

      // הבעלים וסוג התקציב אינם ניתנים לשינוי. שינוי סוג היה הופך
      // רשומות קיימות לחסרות משמעות מול המסך שמציג אותן.
      // get עם ברירת מחדל ולא גישה ישירה: לתקציבים שנוצרו לפני שהיה
      // שדה type אין אותו כלל, וקריאה ישירה הייתה זורקת ושוברת כל עדכון.
      allow update: if isMember(budgetId)
        && validBillingDay(request.resource.data)
        && validBaseAmount(request.resource.data)
        && validOwnerEmail(request.resource.data)
        && validMemberEmails(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.get('type', 'household')
           == resource.data.get('type', 'household');

      allow delete: if isOwner(budgetId);

      // חיובים קבועים: תבנית שממנה נגזרת שורה בכל חודש
      match /recurring/{recurringId} {
        function validTemplate(data) {
          return data.category in ['income', 'fixed', 'leisure', 'fund', 'unplanned']
            && data.budgetGroup in ['fixed', 'leisure', 'savings', 'none']
            && data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.plannedAmount is number && data.plannedAmount >= 0
            && data.actualAmount is number && data.actualAmount >= 0
            && data.startMonth is string && data.startMonth.matches('^[0-9]{4}-[0-9]{2}$')
            && data.active is bool
            && data.skipMonths is list
            && data.skipMonths.size() <= 120
            && validGroupKey(data);
        }

        allow read, delete: if isMember(budgetId);
        allow create: if isMember(budgetId)
          && validTemplate(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        // startMonth קבוע: הזזתו אחורה הייתה מייצרת שורות בחודשים סגורים
        allow update: if isMember(budgetId)
          && validTemplate(request.resource.data)
          && request.resource.data.startMonth == resource.data.startMonth;
      }

      // רשומות התקציב. התקציב נמצא בנתיב ולכן אינו שדה במסמך:
      // אי אפשר לכתוב רשומה שמצהירה על תקציב אחד ויושבת בתוך אחר.
      match /entries/{entryId} {
        function validEntry(data) {
          return data.category in [
              'income', 'fixed', 'leisure', 'fund', 'unplanned',
              'lodging', 'transport', 'attractions', 'dining', 'shopping', 'other',
              'deposit', 'withdrawal'
            ]
            && data.budgetGroup in ['fixed', 'leisure', 'savings', 'none']
            && data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.plannedAmount is number && data.plannedAmount >= 0
            && data.actualAmount is number && data.actualAmount >= 0
            && data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$')
            && (!('date' in data)
                || (data.date is string
                    && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && data.date[0:7] == data.month))
            && data.addedBy is string
            && validGroupKey(data)
            && (!('fromRemainder' in data) || data.fromRemainder == true);
        }

        allow read, delete: if isMember(budgetId);

        // מי שהזין חייב להיות חבר בתקציב, אבל לא בהכרח הכותב. שותף
        // שמעתיק רשומות, למשל בהעברת מבנה, חייב לשמר את מי שהזין
        // אותן במקור. הקיצור לכותב בלבד מנע בדיוק את זה.
        // התכונה שנשמרת היא שאי אפשר לייחס רשומה למי שאינו בתקציב,
        // וזו ממילא אותה רמת אמון שבה שותף כבר יכול לערוך ולמחוק
        // כל שורה של השני.
        allow create: if isMember(budgetId)
          && validEntry(request.resource.data)
          && memberExists(budgetId, request.resource.data.addedBy);

        // מי שהזין נשאר מי שהזין, גם כששותף מעדכן סכום
        allow update: if isMember(budgetId)
          && validEntry(request.resource.data)
          && request.resource.data.addedBy == resource.data.addedBy;
      }

      match /members/{uid} {
        allow read: if isMember(budgetId);

        // מצטרפים רק את עצמכם: או כיוצר התקציב, או עם קוד הזמנה תקף
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && (
            isOwner(budgetId)
            || validInvite(request.resource.data.inviteCode, budgetId)
          );

        // עזיבה עצמית, או הסרה בידי הבעלים. הבעלים יכול להסיר גם את
        // עצמו, כי מחיקת תקציב היא כתיבה אטומית אחת שכוללת את מסמך
        // החבר שלו, והכללים מוערכים מול המצב שלפני הכתיבה כולה.
        // הממשק לא מציע לבעלים לעזוב, רק למחוק את התקציב כולו.
        allow delete: if signedIn()
          && (uid == request.auth.uid || isOwner(budgetId));

        // עדכון השם שלך בלבד. הזהות והתפקיד נעולים, אחרת אפשר היה
        // להפוך את עצמך לבעלים או לגנוב מסמך חבר של מישהו אחר.
        allow update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && (!('email' in request.resource.data)
              || request.resource.data.email == ''
              || request.resource.data.email == request.auth.token.email);
      }
    }

    // פרופיל: שם וגוון, מקור אמת אחד לכל התקציבים.
    // כל מחובר יכול לקרוא פרופיל בודד לפי מזהה, כי שותף חייב לראות
    // את השם של מי שהזין שורה. אין הרשאת list, ולכן אי אפשר לסרוק
    // את כל המשתמשים, ואין כאן מידע שאינו מוצג ממילא בתוך התקציב.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      allow write: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.get('displayName', '') is string
        && request.resource.data.get('displayName', '').size() <= 60
        && request.resource.data.get('tone', 'a1') is string
        && request.resource.data.get('tone', 'a1').size() <= 8;
    }

    // אינדקס אישי פרטי: "באילו תקציבים אני חבר".
    // מצביע בלבד, הרשאות הגישה האמיתיות נאכפות על budgets ועל entries,
    // ולכן מספיק שהמשתמש כותב רק לעץ של עצמו. אין כאן בדיקת isMember
    // בכוונה: המצביע נכתב באותה כתיבה אטומית שיוצרת את מסמך החבר,
    // ובזמן הערכת הכללים הוא עדיין לא קיים.
    match /users/{uid}/memberships/{budgetId} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }

    // מכשירים שרשומים לקבלת התראות. פרטי למשתמש; השולח קורא דרך Admin SDK
    // שעוקף את הכללים, ולכן אין כאן הרשאת קריאה לאף אחד אחר.
    match /users/{uid}/devices/{token} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }

    // הקוד עצמו הוא הסוד; מי שמחזיק בו רשאי לראות לאיזה תקציב הוא שייך
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && isMember(request.resource.data.budgetId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      // ניצול חד-פעמי: רק כיבוי ההזמנה, או ביטול בידי מי שיצר אותה
      allow update: if signedIn()
        && resource.data.active == true
        && request.resource.data.active == false
        && request.resource.data.budgetId == resource.data.budgetId
        && request.resource.data.expiresAt == resource.data.expiresAt;

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // האוסף הישן, ברמה העליונה. נשאר פתוח רק לאורך המיגרציה
    // אל budgets/{budgetId}/entries, ונמחק מכאן בסיומה.
    match /entries/{entryId} {
      function validEntry(data) {
        return data.budgetId is string
          && data.category in [
            'income', 'fixed', 'leisure', 'fund', 'unplanned',
            'lodging', 'transport', 'attractions', 'dining', 'shopping', 'other',
            'deposit', 'withdrawal'
          ]
          && data.budgetGroup in ['fixed', 'leisure', 'savings', 'none']
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.plannedAmount is number && data.plannedAmount >= 0
          && data.actualAmount is number && data.actualAmount >= 0
          && data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$')
          // תאריך אופציונלי, אבל אם יש הוא חייב להתיישב עם החודש,
          // אחרת הוצאת טיול תיספר בחודש הלא נכון
          && (!('date' in data)
              || (data.date is string
                  && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                  && data.date[0:7] == data.month))
          && data.addedBy is string
          && validGroupKey(data)
          // הפקדה שמומנה מהיתרה. אם קיים, חייב להיות אמת: הדגל מסמן
          // מצב אחד ואין משמעות לכתיבתו כשקר
          && (!('fromRemainder' in data) || data.fromRemainder == true);
      }

      // resource הוא null כשהמסמך לא קיים, וגישה ל-resource.data הייתה
      // זורקת ודוחה גם קריאה תמימה של מסמך שטרם נוצר.
      allow read, delete: if resource == null || isMember(resource.data.budgetId);

      allow create: if validEntry(request.resource.data)
        && request.resource.data.addedBy == request.auth.uid
        && isMember(request.resource.data.budgetId);

      // רשומה לא עוברת בין תקציבים, ולא מחליפה בעלות על ההזנה
      allow update: if validEntry(request.resource.data)
        && request.resource.data.budgetId == resource.data.budgetId
        && request.resource.data.addedBy == resource.data.addedBy
        && isMember(resource.data.budgetId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
