rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(budgetId) {
      return signedIn()
        && exists(/databases/$(database)/documents/budgets/$(budgetId)/members/$(request.auth.uid));
    }

    function isOwner(budgetId) {
      return signedIn()
        && get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerUid == request.auth.uid;
    }

    // הזמנה תקפה: קיימת, שייכת לתקציב הנכון, לא נוצלה ולא פגה
    function validInvite(code, budgetId) {
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return invite.budgetId == budgetId
        && invite.active == true
        && request.time < invite.expiresAt;
    }

    match /budgets/{budgetId} {
      allow read: if isMember(budgetId);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.type in ['household', 'trip']
        && (request.resource.data.type != 'trip'
            || (request.resource.data.frame is number
                && request.resource.data.frame >= 0));

      // הבעלים וסוג התקציב אינם ניתנים לשינוי. שינוי סוג היה הופך
      // רשומות קיימות לחסרות משמעות מול המסך שמציג אותן.
      allow update: if isMember(budgetId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.type == resource.data.type;

      allow delete: if isOwner(budgetId);

      // חיובים קבועים: תבנית שממנה נגזרת שורה בכל חודש
      match /recurring/{recurringId} {
        function validTemplate(data) {
          return data.category in ['income', 'fixed', 'leisure', 'fund', 'unplanned']
            && data.budgetGroup in ['fixed', 'leisure', 'savings', 'none']
            && data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.plannedAmount is number && data.plannedAmount >= 0
            && data.actualAmount is number && data.actualAmount >= 0
            && data.startMonth is string && data.startMonth.matches('^[0-9]{4}-[0-9]{2}$')
            && data.active is bool
            && data.skipMonths is list
            && data.skipMonths.size() <= 120;
        }

        allow read, delete: if isMember(budgetId);
        allow create: if isMember(budgetId)
          && validTemplate(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        // startMonth קבוע: הזזתו אחורה הייתה מייצרת שורות בחודשים סגורים
        allow update: if isMember(budgetId)
          && validTemplate(request.resource.data)
          && request.resource.data.startMonth == resource.data.startMonth;
      }

      match /members/{uid} {
        allow read: if isMember(budgetId);

        // מצטרפים רק את עצמכם: או כיוצר התקציב, או עם קוד הזמנה תקף
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && (
            isOwner(budgetId)
            || validInvite(request.resource.data.inviteCode, budgetId)
          );

        // עזיבה עצמית, או הסרה בידי הבעלים
        allow delete: if signedIn()
          && (uid == request.auth.uid || isOwner(budgetId))
          && get(/databases/$(database)/documents/budgets/$(budgetId)).data.ownerUid != uid;

        allow update: if false;
      }
    }

    // אינדקס אישי פרטי: "באילו תקציבים אני חבר".
    // מצביע בלבד, הרשאות הגישה האמיתיות נאכפות על budgets ועל entries,
    // ולכן מספיק שהמשתמש כותב רק לעץ של עצמו. אין כאן בדיקת isMember
    // בכוונה: המצביע נכתב באותה כתיבה אטומית שיוצרת את מסמך החבר,
    // ובזמן הערכת הכללים הוא עדיין לא קיים.
    match /users/{uid}/memberships/{budgetId} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }

    // הקוד עצמו הוא הסוד; מי שמחזיק בו רשאי לראות לאיזה תקציב הוא שייך
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && isMember(request.resource.data.budgetId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      // ניצול חד-פעמי: רק כיבוי ההזמנה, או ביטול בידי מי שיצר אותה
      allow update: if signedIn()
        && resource.data.active == true
        && request.resource.data.active == false
        && request.resource.data.budgetId == resource.data.budgetId
        && request.resource.data.expiresAt == resource.data.expiresAt;

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /entries/{entryId} {
      function validEntry(data) {
        return data.budgetId is string
          && data.category in [
            'income', 'fixed', 'leisure', 'fund', 'unplanned',
            'lodging', 'transport', 'attractions', 'dining', 'shopping', 'other'
          ]
          && data.budgetGroup in ['fixed', 'leisure', 'savings', 'none']
          && data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.plannedAmount is number && data.plannedAmount >= 0
          && data.actualAmount is number && data.actualAmount >= 0
          && data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$')
          // תאריך אופציונלי, אבל אם יש הוא חייב להתיישב עם החודש,
          // אחרת הוצאת טיול תיספר בחודש הלא נכון
          && (!('date' in data)
              || (data.date is string
                  && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                  && data.date[0:7] == data.month))
          && data.addedBy is string;
      }

      allow read, delete: if isMember(resource.data.budgetId);

      allow create: if validEntry(request.resource.data)
        && request.resource.data.addedBy == request.auth.uid
        && isMember(request.resource.data.budgetId);

      // רשומה לא עוברת בין תקציבים, ולא מחליפה בעלות על ההזנה
      allow update: if validEntry(request.resource.data)
        && request.resource.data.budgetId == resource.data.budgetId
        && request.resource.data.addedBy == resource.data.addedBy
        && isMember(resource.data.budgetId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
